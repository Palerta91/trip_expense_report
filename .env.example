# Infrastructure
DATABASE_URL=postgresql://trip:change-me@db:5432/trip_expense
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-central-1
S3_BUCKET=trip-expense-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me

# Application
APP_URL=https://expenses.example.ru
SESSION_COOKIE_SECURE=true

# Optional recognition provider. Keep empty to accept receipts without AI processing.
ENABLE_MINIMAX_RECOGNITION=false
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
